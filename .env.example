# Copy this file to ".env" (NOT this file!) (same folder) and add ONE key to switch on the AI fallback.
# Without a key the assistant uses rules only (0 tokens, $0). ".env" is in .gitignore - never commit it.

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1      # any OpenAI-compatible API (Groq, Together, Ollama...)

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5

# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# ASSIST_LLM=openai          # force one provider, or "off" to switch the AI off
